<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_hr_training_pending_approval_reminders" model="ir.cron">
            <field name="name">HR Training: Pending Approval Reminders</field>
            <field name="model_id" ref="hr_training.model_hr_training_enrollment"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_pending_approval_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_hr_training_session_reminders" model="ir.cron">
            <field name="name">HR Training: Upcoming Session Reminders</field>
            <field name="model_id" ref="hr_training.model_hr_training_enrollment"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_upcoming_session_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
